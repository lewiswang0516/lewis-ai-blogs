---
import { SITE_TITLE } from '../consts';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
	lang: Lang;
	alternates: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const otherLang = (Object.keys(languages) as Lang[]).find((l) => l !== lang) ?? defaultLang;
const switchHref = alternates[otherLang] ?? localizePath('/', otherLang);
---

<header>
	<nav>
		<h2>
			<a href={localizePath('/', lang)}>{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href={localizePath('/', lang)} exact>{t('nav.home')}</HeaderLink>
			<HeaderLink href={localizePath('/blog/', lang)}>{t('nav.blog')}</HeaderLink>
		</div>
		<div class="end-links">
			<SocialLinks lang={lang} />
			<a class="lang-switch" href={switchHref} hreflang={otherLang} aria-label={t('nav.switchLabel')}>
				{t('nav.switch')}
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.end-links {
		display: flex;
		align-items: center;
	}
	.lang-switch {
		font-size: 0.9em;
		white-space: nowrap;
	}
	@media (max-width: 720px) {
		.end-links :global(.social-links) {
			display: none;
		}
	}
</style>
