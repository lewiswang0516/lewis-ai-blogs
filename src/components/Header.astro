---
import { SITE_TITLE } from '../consts';
import { defaultLang, languages, type Lang } from '../i18n/ui';
import { localizePath, useTranslations } from '../i18n/utils';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
	lang: Lang;
	alternates: Partial<Record<Lang, string>>;
}

const { lang, alternates } = Astro.props;
const t = useTranslations(lang);
const otherLang = (Object.keys(languages) as Lang[]).find((l) => l !== lang) ?? defaultLang;
const switchHref = alternates[otherLang] ?? localizePath('/', otherLang);
---

<header>
	<nav>
		<a class="brand" href={localizePath('/', lang)}>{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href={localizePath('/', lang)} exact>{t('nav.home')}</HeaderLink>
			<HeaderLink href={localizePath('/blog/', lang)}>{t('nav.blog')}</HeaderLink>
		</div>
		<div class="end-links">
			<SocialLinks lang={lang} variant="solid" />
			<a class="pill pill-outline lang-switch" href={switchHref} hreflang={otherLang} aria-label={t('nav.switchLabel')}>
				{t('nav.switch')}
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--neutral-background-light) 92%, transparent);
		backdrop-filter: blur(8px);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		width: var(--page-width);
		max-width: calc(100% - 2rem);
		margin: auto;
		padding: 1rem 0;
	}
	.brand {
		color: var(--primary-navy);
		font-size: 1.25rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		text-decoration: none;
		white-space: nowrap;
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
	}
	.end-links {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}
	.lang-switch {
		padding: 0.45rem 1rem;
		white-space: nowrap;
	}
	@media (max-width: 720px) {
		.brand {
			font-size: 1.05rem;
		}
		.end-links :global(.social-links) {
			display: none;
		}
	}
</style>
