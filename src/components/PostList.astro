---
import type { Lang } from '../i18n/ui';
import { postPath, useTranslations, type Post } from '../i18n/utils';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
	lang: Lang;
}

const { posts, lang } = Astro.props;
const t = useTranslations(lang);
const tones = ['purple', 'mint', 'gold', 'pink'] as const;
---

<ul class="post-list">
	{
		posts.map((post, i) => (
			<li>
				<a class:list={['card', tones[i % tones.length]]} href={postPath(post)}>
					<p class="date">
						<FormattedDate date={post.data.pubDate} lang={lang} />
					</p>
					<h3 class="title">{post.data.title}</h3>
					<p class="description">{post.data.description}</p>
					<span class="more">
						{t('post.readMore')}
						<span class="arrow" aria-hidden="true">&rarr;</span>
					</span>
				</a>
			</li>
		))
	}
</ul>
<style>
	.post-list {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		min-height: 300px;
		padding: 1.75rem;
		color: var(--primary-navy);
		text-decoration: none;
		border-radius: var(--radius-card);
		transition:
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}
	.card:hover {
		color: var(--primary-navy);
		box-shadow: var(--card-shadow);
		transform: translateY(-4px);
	}
	.purple {
		background: var(--primary-purple);
	}
	.mint {
		background: var(--secondary-mint);
	}
	.gold {
		background: var(--primary-light-gold);
		box-shadow: inset 0 0 0 1px #fff0b3;
	}
	.pink {
		background: var(--neutral-pink-background);
	}
	.date {
		margin: 0 0 0.75rem;
		color: var(--primary-navy-light);
		font-size: 0.9em;
		font-weight: 500;
	}
	.title {
		margin: 0 0 0.75rem;
		font-size: 1.5rem;
		line-height: 1.25;
	}
	.description {
		margin: 0 0 1.5rem;
	}
	.more {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: auto;
		font-weight: 500;
	}
	.arrow {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		background: #fff;
		border-radius: 999px;
	}
	@media (max-width: 720px) {
		.post-list {
			grid-template-columns: 1fr;
		}
		.card {
			min-height: 0;
			padding: 1.5rem;
		}
	}
</style>
