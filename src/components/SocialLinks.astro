---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
	lang: Lang;
	variant: 'solid' | 'inverse';
}

const { lang, variant } = Astro.props;
const t = useTranslations(lang);
---

<div class:list={['social-links', variant]}>
	<a href="https://github.com/lewiswang0516" target="_blank" rel="noopener">
		<span class="sr-only">{t('social.github')}</span>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
			<path
				fill="currentColor"
				d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
			></path>
		</svg>
	</a>
	<a href="https://lewiswang.com.au" target="_blank" rel="noopener">
		<span class="sr-only">{t('social.portfolio')}</span>
		<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18">
			<path
				fill="currentColor"
				d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0Zm5.9 7.25h-2.66a12.2 12.2 0 0 0-1.1-4.88 6.52 6.52 0 0 1 3.76 4.88ZM8 14.5c-.62 0-1.68-1.86-1.84-5.75h3.68C9.68 12.64 8.62 14.5 8 14.5ZM6.16 7.25C6.32 3.36 7.38 1.5 8 1.5s1.68 1.86 1.84 5.75H6.16Zm-.3-4.88a12.2 12.2 0 0 0-1.1 4.88H2.1a6.52 6.52 0 0 1 3.76-4.88ZM2.1 8.75h2.66a12.2 12.2 0 0 0 1.1 4.88A6.52 6.52 0 0 1 2.1 8.75Zm8.04 4.88a12.2 12.2 0 0 0 1.1-4.88h2.66a6.52 6.52 0 0 1-3.76 4.88Z"
			></path>
		</svg>
	</a>
</div>
<style>
	.social-links {
		display: flex;
		gap: 0.5rem;
	}
	.social-links a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		text-decoration: none;
		border-radius: 999px;
		transition:
			background-color 0.2s ease,
			color 0.2s ease;
	}
	.solid a {
		color: #fff;
		background: var(--primary-navy);
	}
	.solid a:hover {
		background: var(--primary-navy-light);
	}
	.inverse a {
		color: var(--primary-navy);
		background: var(--primary-purple);
	}
	.inverse a:hover {
		background: var(--primary-gold);
	}
</style>
