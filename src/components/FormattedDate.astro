---
import { dateLocale, type Lang } from '../i18n/ui';

interface Props {
	date: Date;
	lang: Lang;
}

const { date, lang } = Astro.props;
---

<time datetime={date.toISOString()}>
	{date.toLocaleDateString(dateLocale[lang], {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
		timeZone: 'Australia/Brisbane',
	})}
</time>
