---
import { SITE_TITLE } from '../consts';
import { htmlLang, type Lang } from '../i18n/ui';
import { alternatesFor, getPosts, localizePath, useTranslations } from '../i18n/utils';
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import PostList from './PostList.astro';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const alternates = alternatesFor('/');
const latest = (await getPosts(lang)).slice(0, 5);
---

<!doctype html>
<html lang={htmlLang[lang]}>
	<head>
		<BaseHead title={SITE_TITLE} description={t('site.description')} lang={lang} alternates={alternates} />
	</head>
	<body>
		<Header lang={lang} alternates={alternates} />
		<main>
			<section class="intro">
				<h1>{t('home.greeting')}</h1>
				<p class="lead">{t('home.intro')}</p>
				<p class="links">
					<a class="pill pill-solid" href="https://github.com/lewiswang0516" target="_blank" rel="noopener">{t('social.github')}</a>
					<a class="pill pill-outline" href="https://lewiswang.com.au" target="_blank" rel="noopener">{t('social.portfolio')}</a>
				</p>
			</section>
			<section>
				<div class="section-head">
					<h2>{t('home.latest')}</h2>
					<a class="pill pill-outline" href={localizePath('/blog/', lang)}>{t('home.allPosts')} &rarr;</a>
				</div>
				<PostList posts={latest} lang={lang} />
			</section>
		</main>
		<Footer lang={lang} />
	</body>
</html>
<style>
	.intro {
		padding: 2rem 0 4rem;
	}
	.intro h1 {
		margin-bottom: 1.25rem;
	}
	.lead {
		max-width: 40rem;
		margin-bottom: 2rem;
		font-size: 1.15em;
		font-weight: 500;
	}
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 0;
	}
	.section-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}
	.section-head h2 {
		margin: 0;
		color: var(--primary-navy-light);
	}
	@media (max-width: 720px) {
		.intro {
			padding: 1rem 0 2.5rem;
		}
		.section-head {
			align-items: center;
		}
	}
</style>
