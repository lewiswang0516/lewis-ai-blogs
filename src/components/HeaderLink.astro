---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & { exact?: boolean };

const { href, exact = false, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const target = String(href);
const isActive = exact ? pathname === target : pathname.startsWith(target);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		padding: 0.5rem 1rem;
		color: var(--primary-navy);
		font-weight: 500;
		text-decoration: none;
		border-radius: 999px;
		transition: background-color 0.2s ease;
	}
	a:hover {
		background: var(--primary-purple-light);
	}
	a.active {
		background: var(--primary-purple);
	}
	@media (max-width: 720px) {
		a {
			padding: 0.4rem 0.75rem;
		}
	}
</style>
