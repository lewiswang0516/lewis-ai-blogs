---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { htmlLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

type Props = CollectionEntry<'blog'>['data'] & {
	lang: Lang;
	alternates: Partial<Record<Lang, string>>;
};

const { title, description, pubDate, updatedDate, heroImage, lang, alternates } = Astro.props;
const t = useTranslations(lang);
---

<html lang={htmlLang[lang]}>
	<head>
		<BaseHead title={title} description={description} lang={lang} alternates={alternates} image={heroImage} />
		<style>
			.hero-image img {
				display: block;
				width: 100%;
				margin: 0 auto 2rem;
				border-radius: var(--radius-card);
				box-shadow: var(--card-shadow);
			}
			.post-head {
				max-width: 960px;
				margin: 0 auto 3rem;
				padding: clamp(2rem, 5vw, 3.5rem);
				text-align: center;
				background: var(--primary-purple);
				border-radius: 32px;
			}
			.post-head h1 {
				margin: 0 0 1rem;
				font-size: clamp(2rem, 1.4rem + 2.4vw, 3.25rem);
				line-height: 1.1;
			}
			.date {
				margin-bottom: 1rem;
				color: var(--primary-navy-light);
				font-weight: 500;
			}
			.lead {
				max-width: 40rem;
				margin: 0 auto;
				font-size: 1.1em;
				font-weight: 500;
			}
			.prose {
				width: var(--prose-width);
				max-width: 100%;
				margin: auto;
			}
		</style>
	</head>

	<body>
		<Header lang={lang} alternates={alternates} />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)}
				<header class="post-head">
					<div class="date">
						<FormattedDate date={pubDate} lang={lang} />
						{updatedDate && (
							<div>
								{t('post.updated')} <FormattedDate date={updatedDate} lang={lang} />
							</div>
						)}
					</div>
					<h1>{title}</h1>
					<p class="lead">{description}</p>
				</header>
				<div class="prose">
					<slot />
				</div>
			</article>
		</main>
		<Footer lang={lang} />
	</body>
</html>
