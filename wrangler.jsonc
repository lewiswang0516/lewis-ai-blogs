{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lewis-ai-blogs",
  // Pinned to the personal account, so a fallback to the company
  // OAuth login fails instead of deploying to another account.
  "account_id": "e8f2d3d6532ac22e30fccb438ea63a55",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "observability": {
    "enabled": true,
  },
}
